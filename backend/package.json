{
  "name": "deero-management-backend",
  "version": "1.0.0",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev:server": "nodemon --config nodemon.json",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev --prefix ../frontend\"",
    "start": "node src/index.js",
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "server": "nodemon --config nodemon.json",
    "client": "npm run dev --prefix ../frontend",
    "frontend:start": "npm start --prefix ../frontend",
    "prod": "concurrently npm:start npm:frontend:start",
    "test": "node --test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:push": "prisma db push && prisma generate",
    "db:seed-services": "node src/scripts/seed-services.js",
    "db:seed-workflows": "node src/scripts/seed-workflow-templates.js",
    "db:test": "node src/scripts/check-db.js",
    "create-admin": "node src/scripts/create-admin.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@prisma/client": "^5.22.0",
    "better-auth": "^1.3.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "mysql2": "^3.22.2",
    "nodemailer": "^9.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
