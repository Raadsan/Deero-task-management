model RecurringSchedule {
  id                String                  @id
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  name              String
  recurrenceType    RecurrenceType
  customRule        String?                 @db.Text
  contentType       ContentType             @default(OTHER)
  startDate         DateTime
  endDate           DateTime?
  isActive          Boolean                 @default(true)
  autoGenerateTasks Boolean                 @default(true)
  clientId          String
  portfolioId       String?
  cycles            ContentCycle[]
  steps             RecurringScheduleStep[]
  portfolio         Portfolio?              @relation(fields: [portfolioId], references: [id], map: "recurring_schedules_branchId_fkey")
  client            Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([isActive])
  @@index([portfolioId], map: "recurring_schedules_branchId_fkey")
  @@map("recurring_schedules")
}

/// Day-of-week steps inside a recurring schedule (e.g. Monday = shoot, Tuesday = edit)
model RecurringScheduleStep {
  id             String                    @id @default(uuid())
  createdAt      DateTime                  @default(now())
  scheduleId     String
  dayOfWeek      Int?
  dayOfMonth     Int?
  stepOrder      Int                       @default(0)
  label          String
  contentType    ContentType?
  department     String?
  templateId     String?
  assigneeId     String?
  assigneeIds    Json?
  startHour      String?                   @default("09:00")
  estimatedHours Float?                    @default(2)
  intervalDays   Int?
  supervisor     String                    @default("")
  assignee       Staff?                    @relation("RecurringStepAssignee", fields: [assigneeId], references: [id])
  schedule       RecurringSchedule         @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  template       WorkflowTemplate?         @relation(fields: [templateId], references: [id])
  occurrences    RecurringTaskOccurrence[]

  @@index([scheduleId])
  @@index([assigneeId])
  @@index([templateId], map: "recurring_schedule_steps_templateId_fkey")
  @@map("recurring_schedule_steps")
}

/// One generated task instance per schedule step per calendar day (prevents duplicates)
model RecurringTaskOccurrence {
  id             String                @id @default(uuid())
  createdAt      DateTime              @default(now())
  scheduleStepId String
  scheduledDate  DateTime              @db.Date
  taskId         String                @unique
  scheduleStep   RecurringScheduleStep @relation(fields: [scheduleStepId], references: [id], onDelete: Cascade)
  task           Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([scheduleStepId, scheduledDate])
  @@index([scheduledDate])
  @@map("recurring_task_occurrences")
}

model ContentCycle {
  id          String             @id
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  cycleNumber Int
  periodStart DateTime
  periodEnd   DateTime
  status      ContentCycleStatus @default(PLANNED)
