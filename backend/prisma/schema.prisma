generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  users       User[]
  menuAccess  RoleMenuAccess[]

  @@map("roles")
}

enum TransactionType {
  income
  expense
}

enum TaskStatus {
  pending
  overdue
  completed
}

enum TaskPriority {
  normal
  medium
  urgent
}

enum ClientServiceStatus {
  pending
  completed
}

// ─── Media agency client & workflow enums ───────────────────────────────────

enum ClientType {
  ONE_TIME
  MANAGED_ON_DEMAND
  MANAGED_RECURRING
}

enum ProjectStatus {
  LEAD
  PENDING_PAYMENT
  ACTIVE
  REVIEW
  COMPLETED
  CANCELLED
}

enum ProjectPriority {
  low
  medium
  high
  urgent
}

enum ContentType {
  VIDEO
  GRAPHIC_DESIGN
  PHOTOGRAPHY
  SOCIAL_MEDIA_POST
  MARKETING_CAMPAIGN
  OTHER
}

enum ContentRequestStatus {
  DRAFT
  PLANNING
  PRODUCTION
  EDITING
  REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  COMPLETED
}

enum RecurrenceType {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED
}

enum InstallmentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum ContentCycleStatus {
  PLANNED
  IN_PROGRESS
  REVIEW
  COMPLETED
  SKIPPED
}

enum WorkflowStage {
  pending
  in_progress
  review
  completed
  blocked
}

enum EntityType {
  users
  tasks
  clients
  services
  subservices
  payments
  invoice
  tax
  branches
  departments
  projects
  content_requests
  recurring_schedules
  content_cycles
  workflow_templates
  contracts
}

model User {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name          String
  email         String  @unique
  emailVerified Boolean
  image         String?
  gender        String?
  salary        String?

  department String?
  branchId   String?
  branch     Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  sessions      Session[]
  accounts      Account[]
  assignedTasks Task[]      @relation("TaskAssignee")
  userFiles     UserFiles[]

  roleId             String?
  dynamicRole        Role?                @relation(fields: [roleId], references: [id])
  role               String?              @default("user")
  banned             Boolean?
  banReason          String?
  banExpires         DateTime?
  incomeTransaction  IncomeTransaction[]
  expenseTransaction ExpenseTransaction[]

  reciever                  UserSalary[]             @relation(name: "Reciever")
  registerer                UserSalary[]             @relation(name: "Registerer")
  auditLogs                 AuditLog[]
  managedClients            Client[]                 @relation("ClientAccountManager")
  createdProjects           Project[]                @relation("ProjectCreatedBy")
  contentRequestsCreated    ContentRequest[]         @relation("ContentRequestCreatedBy")
  contentRequestAssignments ContentRequestAssignee[]
  assignedRecurringSteps    RecurringScheduleStep[]  @relation("RecurringStepAssignee")
  createdContracts          Contract[]               @relation("ContractCreatedBy")
  uploadedContractDocuments ContractDocument[]       @relation("ContractDocumentUploadedBy")

  @@map("Users")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  token     String  @unique
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@map("sessions")
}

model Account {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountId  String
  providerId String

  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  @@map("accounts")
}

model Verification {
  id        String    @id @default(uuid())
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  identifier String
  value      String
  expiresAt  DateTime

  @@map("verifications")
}

model Client {
  id        String    @id
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  institution       String
  companyName       String?
  contactPerson     String?
  email             String     @unique
  phone             String     @unique
  address           String?    @db.Text
  source            String
  clientType        ClientType @default(ONE_TIME)
  contractStartDate DateTime?
  contractEndDate   DateTime?
  monthlyBudget     Float?
  notes             String?    @db.Text
  isActive          Boolean    @default(true)
  isDraft           Boolean    @default(false)

  branchId         String?
  branch           Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  accountManagerId String?
  accountManager   User?   @relation("ClientAccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)

  clientService      ClientService[]
  clientTask         ClientTask[]
  clientSubService   ClientSubService[]
  serviceAgreements  IncomeServiceAgreement[]
  projects           Project[]
  contentRequests    ContentRequest[]
  recurringSchedules RecurringSchedule[]
  contentCycles      ContentCycle[]
  contracts          Contract[]
  installments       ClientInstallment[]

  @@index([clientType])
  @@index([branchId])
  @@index([isDraft])
  @@map("clients")
}

model Service {
  id String @id

  serviceName   String
  description   String?         @db.Text
  branchId      String?
  branch        Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  clientService ClientService[]
  subService    SubService[]

  serviceAgreements IncomeServiceAgreement[]

  @@unique([serviceName, branchId])
  @@map("services")
}

model SubService {
  id          String  @id
  name        String
  description String? @db.Text

  categoryId String
  service    Service @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  clientSubService ClientSubService[]

  serviceAgreements IncomeServiceAgreement[]

  @@unique([name, categoryId])
  @@map("subservices")
}

model Branch {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name            String  @unique
  slug            String? @unique
  description     String?
  location        String?
  phone           String?
  logoUrl         String?
  iconLogoUrl     String?
  usesRootLogin   Boolean @default(false)
  slugClearedOnce Boolean @default(false)
  primaryColor    String  @default("#651210")
  secondaryColor  String  @default("#ec4724")
  customDomain    String? @unique
  isActive        Boolean @default(true)

  users              User[]
  services           Service[]
  departments        Department[]
  clients            Client[]
  projects           Project[]
  contentRequests    ContentRequest[]
  recurringSchedules RecurringSchedule[]
  contracts          Contract[]

  @@map("branches")
}

model Department {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String
  description String? @db.Text
  isActive    Boolean @default(true)
  branchId    String
  branch      Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([name, branchId])
  @@map("departments")
}

model ClientSubService {
  subServiceId String
  count        Int
  subService   SubService @relation(fields: [subServiceId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([subServiceId, clientId])
  @@map("ClientSubServices")
}

model ClientService {
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([serviceId, clientId])
  @@map("clientServices")
}

model Task {
  id        String    @id
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  description   String
  status        TaskStatus
  priority      TaskPriority  @default(normal)
  department    String
  deadline      DateTime?
  progress      Int           @default(0)
  workflowStage WorkflowStage @default(pending)
  sortOrder     Int           @default(0)

  assgineeId         String
  user               User    @relation("TaskAssignee", fields: [assgineeId], references: [id], onDelete: Cascade)
  supervisor         String  @default("")
  serviceInformation String?
  isPersonal         Boolean @default(false)

  projectId        String?
  project          Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contentRequestId String?
  contentRequest   ContentRequest?         @relation(fields: [contentRequestId], references: [id], onDelete: SetNull)
  contentCycleId   String?
  contentCycle     ContentCycle?           @relation(fields: [contentCycleId], references: [id], onDelete: SetNull)
  agreementId      String?
  agreement        IncomeServiceAgreement? @relation(fields: [agreementId], references: [id], onDelete: SetNull)
  workflowStepId   String?
  workflowStep     WorkflowTemplateStep?   @relation(fields: [workflowStepId], references: [id], onDelete: SetNull)

  clientTask          ClientTask[]
  recurringOccurrence RecurringTaskOccurrence?

  @@index([projectId])
  @@index([contentRequestId])
  @@index([contentCycleId])
  @@index([agreementId])
  @@map("tasks")
}

model ClientTask {
  createdAt DateTime? @default(now())

  clientId String
  taskId   String

  Client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([clientId, taskId])
  @@map("clienttasks")
}

model Counter {
  id        Int       @id @default(autoincrement())
  updatedAt DateTime? @updatedAt

  entity   EntityType
  year     Int
  month    Int
  sequence Int        @default(0)

  @@unique([entity, year, month])
}

model Income {
  id                String              @id
  createdAt         DateTime            @default(now())
  incomeType        String
  incomeTransaction IncomeTransaction[]

  @@map("incomes")
}

model Expense {
  id          String   @id
  createdAt   DateTime @default(now())
  expenseType String

  expenseTransaction ExpenseTransaction[]

  @@map("expenses")
}

model IncomeTransaction {
  id        String   @id
  createdAt DateTime @default(now())

  userId           String
  user             User    @relation(fields: [userId], references: [id])
  incomeCategoryId String?

  duetoDate DateTime?
  status    String
  method    String
  notes     String
  discount  String?

  taxType  String
  taxValue Float

  totalAmount Float
  amountPaid  Float
  subTotal    Float?

  income Income? @relation(fields: [incomeCategoryId], references: [id])

  agreementId      String
  serviceAgreement IncomeServiceAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  transactionDetails IncomeTransactionDetails[]

  @@map("IncomeTransactions")
}

model ExpenseTransaction {
  id        String   @id
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  duetoDate DateTime?
  status    String
  method    String
  notes     String

  totalAmount Float
  amountPaid  Float

  expenseCategoryId String

  expense Expense @relation(fields: [expenseCategoryId], references: [id], onDelete: Cascade)

  expneseAgreementId      String
  expenseServiceAgreement ExpenseServiceAgreement @relation(fields: [expneseAgreementId], references: [id], onDelete: Cascade)

  expenseTransactionDetails ExpenseTransactionDetails[]

  @@map("ExpenseTransactions")
}

model IncomeTransactionDetails {
  id                  String            @id @default(uuid())
  createdAt           DateTime          @default(now())
  paidAmount          Float
  incomeTransactionId String
  transction          IncomeTransaction @relation(fields: [incomeTransactionId], references: [id], onDelete: Cascade)
}

model UserFiles {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  url       String
  name      String
  fileSize  Int
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IncomeServiceAgreement {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  base        Float
  discount    Float
  description String
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  subServiceId String
  subService   SubService @relation(fields: [subServiceId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  serviceStatus ClientServiceStatus @default(pending)

  incomeTransaction IncomeTransaction[]
  tasks             Task[]

  @@index([projectId])
}

model ExpenseServiceAgreement {
  id                 String               @id @default(uuid())
  createdAt          DateTime             @default(now())
  base               Float
  description        String
  expenseTransaction ExpenseTransaction[]
}

model ExpenseTransactionDetails {
  id                   String             @id @default(uuid())
  createdAt            DateTime           @default(now())
  paidAmount           Float
  expenseTransactionId String
  expenseTransaction   ExpenseTransaction @relation(fields: [expenseTransactionId], references: [id], onDelete: Cascade)
}

model UserSalary {
  id           String    @id @default(uuid())
  createdAt    DateTime  @default(now())
  dueToDate    DateTime?
  totalAmount  Float
  tax          String
  status       String
  method       String
  notes        String?
  taxType      String
  recieverId   String
  registeredBy String

  registeredUser User @relation(name: "Registerer", fields: [registeredBy], references: [id])
  recieverUser   User @relation(name: "Reciever", fields: [recieverId], references: [id])

  UserSalaryDetails UserSalaryDetails[]
}

model UserSalaryDetails {
  id         String     @id @default(uuid())
  createdAt  DateTime   @default(now())
  paidAmount Float
  salaryId   String
  userSalary UserSalary @relation(fields: [salaryId], references: [id], onDelete: Cascade)
}

model Notification {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  taskId       String
  taskName     String
  assigneeName String
  deadline     DateTime
  type         String
  userId       String
  isSeen       Boolean  @default(false)

  @@map("notifications")
}

model NavMenu {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title    String
  url      String
  icon     String?
  order    Int     @default(0)
  isActive Boolean @default(true)

  subMenus   NavSubMenu[]
  roleAccess RoleMenuAccess[]

  @@map("nav_menus")
}

model NavSubMenu {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menuId   String
  menu     NavMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  title    String
  url      String
  order    Int     @default(0)
  isActive Boolean @default(true)

  roleAccess RoleSubMenuAccess[]

  @@map("nav_submenus")
}

model RoleMenuAccess {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roleId    String
  menuId    String
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menu      NavMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  canView   Boolean @default(true)
  canAdd    Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)

  subAccess RoleSubMenuAccess[]

  @@unique([roleId, menuId])
  @@map("role_menu_access")
}

model RoleSubMenuAccess {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roleMenuAccessId String
  subMenuId        String
  roleMenuAccess   RoleMenuAccess @relation(fields: [roleMenuAccessId], references: [id], onDelete: Cascade)
  subMenu          NavSubMenu     @relation(fields: [subMenuId], references: [id], onDelete: Cascade)
  canView          Boolean        @default(true)
  canAdd           Boolean        @default(false)
  canEdit          Boolean        @default(false)
  canDelete        Boolean        @default(false)

  @@unique([roleMenuAccessId, subMenuId])
  @@map("role_submenu_access")
}

model AuditLog {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  entity      String
  entityId    String?
  description String?  @db.Text

  @@map("audit_logs")
}

// ─── Media agency: projects, content, recurring, workflows ───────────────────

model Project {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String
  description String?         @db.Text
  projectType ContentType     @default(OTHER)
  status      ProjectStatus   @default(LEAD)
  priority    ProjectPriority @default(medium)
  startDate   DateTime?
  dueDate     DateTime?

  clientId    String
  client      Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?   @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  serviceAgreements IncomeServiceAgreement[]
  contentRequests   ContentRequest[]
  tasks             Task[]
  contracts         Contract[]

  @@index([clientId])
  @@index([status])
  @@index([branchId])
  @@map("projects")
}

model Contract {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contractNumber String         @unique
  startDate      DateTime?
  endDate        DateTime?
  renewalDate    DateTime?
  totalAmount    Float?
  monthlyAmount  Float?
  billingDay     Int?           @default(1)
  paymentTerms   String?        @db.Text
  status         ContractStatus @default(ACTIVE)
  notes          String?        @db.Text

  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?    @relation("ContractCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  documents    ContractDocument[]
  installments ClientInstallment[]

  @@index([clientId])
  @@index([projectId])
  @@index([status])
  @@index([branchId])
  @@map("contracts")
}

model ClientInstallment {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sourceKey   String
  periodYear  Int
  periodMonth Int
  dueDate     DateTime
  dueAmount   Float
  paidAmount  Float             @default(0)
  status      InstallmentStatus @default(PENDING)
  notes       String?           @db.Text

  clientId   String
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@unique([sourceKey, periodYear, periodMonth])
  @@index([clientId])
  @@index([status])
  @@index([periodYear, periodMonth])
  @@map("client_installments")
}

model ContractDocument {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  contractId   String
  contract     Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  version      Int
  fileName     String
  fileUrl      String
  fileSize     Int?
  mimeType     String   @default("application/pdf")
  uploadedById String?
  uploadedBy   User?    @relation("ContractDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([contractId, version])
  @@index([contractId])
  @@map("contract_documents")
}

model ContentRequest {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  description String?              @db.Text
  contentType ContentType
  status      ContentRequestStatus @default(DRAFT)
  deadline    DateTime?

  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?    @relation("ContentRequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  assignees ContentRequestAssignee[]
  tasks     Task[]

  @@index([clientId])
  @@index([status])
  @@index([contentType])
  @@map("content_requests")
}

model ContentRequestAssignee {
  id               String         @id @default(uuid())
  createdAt        DateTime       @default(now())
  contentRequestId String
  contentRequest   ContentRequest @relation(fields: [contentRequestId], references: [id], onDelete: Cascade)
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             String?

  @@unique([contentRequestId, userId])
  @@map("content_request_assignees")
}

model RecurringSchedule {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name              String
  recurrenceType    RecurrenceType
  customRule        String?        @db.Text
  contentType       ContentType    @default(OTHER)
  startDate         DateTime
  endDate           DateTime?
  isActive          Boolean        @default(true)
  autoGenerateTasks Boolean        @default(true)

  clientId String
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  steps  RecurringScheduleStep[]
  cycles ContentCycle[]

  @@index([clientId])
  @@index([isActive])
  @@map("recurring_schedules")
}

/// Day-of-week steps inside a recurring schedule (e.g. Monday = shoot, Tuesday = edit)
model RecurringScheduleStep {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  scheduleId  String
  schedule    RecurringSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  dayOfWeek   Int?
  dayOfMonth  Int?
  intervalDays Int?
  stepOrder   Int               @default(0)
  label       String
  contentType ContentType?
  department  String?
  supervisor  String            @default("")
  assigneeId  String?
  assignee    User?             @relation("RecurringStepAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  templateId  String?
  template    WorkflowTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  occurrences RecurringTaskOccurrence[]

  @@index([scheduleId])
  @@index([assigneeId])
  @@map("recurring_schedule_steps")
}

/// One generated task instance per schedule step per calendar day (prevents duplicates)
model RecurringTaskOccurrence {
  id             String                @id @default(uuid())
  createdAt      DateTime              @default(now())
  scheduleStepId String
  scheduleStep   RecurringScheduleStep @relation(fields: [scheduleStepId], references: [id], onDelete: Cascade)
  scheduledDate  DateTime              @db.Date
  taskId         String                @unique
  task           Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([scheduleStepId, scheduledDate])
  @@index([scheduledDate])
  @@map("recurring_task_occurrences")
}

model ContentCycle {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cycleNumber Int
  periodStart DateTime
  periodEnd   DateTime
  status      ContentCycleStatus @default(PLANNED)

  scheduleId String?
  schedule   RecurringSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  clientId   String
  client     Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)

  tasks Task[]

  @@index([clientId])
  @@index([scheduleId])
  @@map("content_cycles")
}

model WorkflowTemplate {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String
  description String?      @db.Text
  clientType  ClientType?
  contentType ContentType?
  isDefault   Boolean      @default(false)
  isActive    Boolean      @default(true)

  steps          WorkflowTemplateStep[]
  recurringSteps RecurringScheduleStep[]

  @@index([clientType, contentType])
  @@map("workflow_templates")
}

model WorkflowTemplateStep {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  templateId      String
  template        WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  stepOrder       Int
  taskName        String
  description     String?          @db.Text
  department      String?
  defaultPriority TaskPriority     @default(normal)
  estimatedDays   Int?
  workflowStage   WorkflowStage    @default(pending)

  generatedTasks Task[]

  @@unique([templateId, stepOrder])
  @@map("workflow_template_steps")
}
